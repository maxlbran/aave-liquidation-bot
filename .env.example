# ── Copy this file to .env and fill in your values ──────────────────────────
# NEVER commit .env to git

# ── RPC ──────────────────────────────────────────────────────────────────────
ALCHEMY_WS_URL=wss://arb-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
ALCHEMY_HTTP_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Testnet (Arbitrum Sepolia)
ALCHEMY_WS_URL_TESTNET=wss://arb-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
ALCHEMY_HTTP_URL_TESTNET=https://arb-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# ── Wallet ────────────────────────────────────────────────────────────────────
# Dedicated hot wallet for gas payments ONLY
# Fund with 0.01 ETH on Arbitrum to start
WALLET_ADDRESS=0xYOUR_WALLET_ADDRESS
PRIVATE_KEY=0xYOUR_PRIVATE_KEY

# ── Network ───────────────────────────────────────────────────────────────────
# 42161 = Arbitrum One (mainnet), 421614 = Arbitrum Sepolia (testnet)
CHAIN_ID=421614

# ── Contract ─────────────────────────────────────────────────────────────────
# Set after deploying LiquidationBot.sol
BOT_CONTRACT_ADDRESS=

# ── Strategy ─────────────────────────────────────────────────────────────────
MIN_PROFIT_USD=10.0

# ── Telegram ─────────────────────────────────────────────────────────────────
# Create bot via @BotFather, get token and your chat ID via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log

# ── Database ─────────────────────────────────────────────────────────────────
DB_PATH=data/bot.db
