[Unit]
Description=Aave V3 Liquidation Bot (Arbitrum)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/aave-liquidation-bot

# Load secrets from .env (systemd native — no dotenv needed at OS level)
EnvironmentFile=/home/ubuntu/aave-liquidation-bot/.env

ExecStart=/home/ubuntu/aave-liquidation-bot/venv/bin/python main.py

# Restart policy: always restart on crash, but back off on repeated failures
Restart=always
RestartSec=10
StartLimitInterval=600   # 10-minute window
StartLimitBurst=5        # max 5 restarts in that window

# Logging: redirect to journald (use `journalctl -u liquidation-bot -f`)
StandardOutput=journal
StandardError=journal
SyslogIdentifier=liquidation-bot

# Security hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/home/ubuntu/aave-liquidation-bot/data
ReadWritePaths=/home/ubuntu/aave-liquidation-bot/logs

# Resource limits
LimitNOFILE=65536
MemoryMax=1G
CPUQuota=80%

[Install]
WantedBy=multi-user.target
